[2025-04-14T22:52:31.647324+02:00] doctrine.DEBUG: Executing statement: INSERT INTO article (title, description, created_at, updated_at, image, category_id) VALUES (?, ?, ?, ?, ?, ?) (parameters: array{"1":"Bonjour","2":"La lecture joue un rôle essentiel dans l'épanouissement intellectuel et émotionnel. En explorant divers genres littéraires, le lecteur enrichit non seulement ses connaissances, mais aussi sa capacité à analyser et à ressentir. Les livres offrent une évasion, tout en stimulant l'imagination et la créativité. De plus, la lecture régulière améliore la concentration et réduit le stress, en offrant une pause bienvenue dans un monde souvent agité. Par ailleurs, la lecture favorise l'empathie en permettant de vivre des expériences à travers les personnages. Elle ouvre également des portes sur d'autres cultures et perspectives, renforçant ainsi la tolérance et la compréhension mutuelle. Que ce soit à travers des romans, des essais ou des biographies, chaque livre apporte une valeur unique, contribuant à forger une pensée critique et une vision plus large du monde. Cultiver l'habitude de lire est donc un investissement précieux pour son développement personnel.","3":"2025-04-14 22:52:30","4":"2025-04-14 22:52:31","5":"blog-recent-2-67fd758f96979918938919.jpg","6":3}, types: array{"1":2,"2":2,"3":2,"4":2,"5":2,"6":1}) {"sql":"INSERT INTO article (title, description, created_at, updated_at, image, category_id) VALUES (?, ?, ?, ?, ?, ?)","params":{"1":"Bonjour","2":"La lecture joue un rôle essentiel dans l'épanouissement intellectuel et émotionnel. En explorant divers genres littéraires, le lecteur enrichit non seulement ses connaissances, mais aussi sa capacité à analyser et à ressentir. Les livres offrent une évasion, tout en stimulant l'imagination et la créativité. De plus, la lecture régulière améliore la concentration et réduit le stress, en offrant une pause bienvenue dans un monde souvent agité. Par ailleurs, la lecture favorise l'empathie en permettant