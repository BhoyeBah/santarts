[2025-04-14T16:45:33.783420+02:00] doctrine.DEBUG: Executing statement: UPDATE article SET title = ?, description = ? WHERE id = ? (parameters: array{"1":"L'importance de la lecture dans le développement personnel","2":"La lecture joue un rôle essentiel dans l'épanouissement intellectuel et émotionnel. En explorant divers genres littéraires, le lecteur enrichit non seulement ses connaissances, mais aussi sa capacité à analyser et à ressentir. Les livres offrent une évasion, tout en stimulant l'imagination et la créativité. De plus, la lecture régulière améliore la concentration et réduit le stress, en offrant une pause bienvenue dans un monde souvent agité.\r\n\r\nPar ailleurs, la lecture favorise l'empathie en permettant de vivre des expériences à travers les personnages. Elle ouvre également des portes sur d'autres cultures et perspectives, renforçant ainsi la tolérance et la compréhension mutuelle. Que ce soit à travers des romans, des essais ou des biographies, chaque livre apporte une valeur unique, contribuant à forger une pensée critique et une vision plus large du monde. Cultiver l'habitude de lire est donc un investissement précieux pour son développement personnel.","3":3}, types: array{"1":2,"2":2,"3":1}) {"sql":"UPDATE article SET title = ?, description = ? WHERE id = ?","params":{"1":"L'importance de la lecture dans le développement personnel","2":"La lecture joue un rôle essentiel dans l'épanouissement intellectuel et émotionnel. En explorant divers genres littéraires, le lecteur enrichit non seulement ses connaissances, mais aussi sa capacité à analyser et à ressentir. Les livres offrent une évasion, tout en stimulant l'imagination et la créativité. De plus, la lecture régulière améliore la concentration et réduit le stress, en offrant une pause bienvenue dans un monde souvent agité.\r\n\r\nPar ailleurs, la lecture favorise l'empathie en permettant de vivre des expériences à travers les personnages. Elle ouvre également des portes sur d'autres culture